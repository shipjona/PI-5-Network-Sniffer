[Unit]
Description=Grizzl-E Charger Monitor Collector
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grizzlepi
Group=grizzl-monitor
WorkingDirectory=/home/grizzlepi/grizzl-monitor
EnvironmentFile=-/etc/grizzl-monitor/grizzl-monitor.env
ExecStart=/home/grizzlepi/grizzl-monitor/.venv/bin/python /home/grizzlepi/grizzl-monitor/service.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
