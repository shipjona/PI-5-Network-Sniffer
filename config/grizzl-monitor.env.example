# Copy to /etc/grizzl-monitor/grizzl-monitor.env on the Raspberry Pi.
# Do not commit the real environment file.

GRIZZL_PRODUCTION_WIFI_PASSWORD=change-me
GRIZZL_TEST_WIFI_PASSWORD=change-me
GRIZZL_FLASK_SECRET_KEY=change-me-long-random-string
GRIZZL_REPORT_TIMEZONE=America/Tijuana

# Keep disabled for the offline work-site appliance unless testing at home.
GRIZZL_ENABLE_TEST_CHARGER=0

# Set to 0 for a headless offline appliance that must collect charger data
# with no Ethernet cable attached. Keep 1 while developing over Wi-Fi SSH.
GRIZZL_REQUIRE_ETHERNET_FOR_WIFI=1

# Weekly email report settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=reporting@example.com
SMTP_PASSWORD=change-me
REPORT_SENDER=reporting@example.com
REPORT_RECIPIENT=ops@example.com
